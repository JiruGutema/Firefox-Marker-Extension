{
  "manifest_version": 2,
  "name": "Web Marker",
  "description": "Draw on any webpage with markers, highlighters, shapes, notes and text tools",
  "version": "4.0.0",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "clipboardWrite",
    "menus"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": "icon.png",
    "default_title": "Web Marker"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open or close Web Marker on the current page"
    }
  },
  "background": {
    "scripts": [
      "shared/storage.js",
      "shared/css.js",
      "background.js"
    ],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jiregnaG@gmail.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
